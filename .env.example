APP_ENV=development
APP_PORT=
APP_URL=

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# ──────────────────────────────────────────────────────────────────────────────
# Usuario de la aplicación — Principio de Mínimos Privilegios (issue #94)
# ──────────────────────────────────────────────────────────────────────────────
# La aplicación se conecta SIEMPRE con DB_USER / DB_PASSWORD, nunca con
# POSTGRES_USER (superusuario). DB_USER es un rol con LOGIN, sin SUPERUSER,
# sin CREATEDB y sin CREATEROLE, dueño de la base de datos y del esquema
# public. Se crea automáticamente la primera vez que se inicializa el volumen
# de Postgres (ver docker/postgres-init/01-app-user.sh).
#
#   DB_USER=techhub
#   DB_PASSWORD=techhub
#
DB_USER=
DB_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────────
# SMTP — Recuperación de contraseña (issue #15)
# ──────────────────────────────────────────────────────────────────────────────
# Sin estas variables, los correos se loguean en storage/logs/mail_dev.log.
# Cuando el cliente confirme el servidor universitario, define:
#
#   MAIL_DRIVER=smtp              # activa el envío real (por defecto: log)
#   SMTP_HOST=smtp.uls.cl         # host del servidor universitario
#   SMTP_PORT=587                 # 587 = STARTTLS  |  465 = SSL
#   SMTP_USER=no-reply@uls.cl     # cuenta de envío
#   SMTP_PASS=                    # contraseña de la cuenta SMTP
#   SMTP_FROM=no-reply@uls.cl     # dirección From visible en el correo
#   SMTP_FROM_NAME=TechHub ULS    # nombre del remitente
#
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@techhub.uls.cl
SMTP_FROM_NAME=TechHub ULS

# ──────────────────────────────────────────────────────────────────────────────
# Notificación de consultas del formulario de contacto (issue notificación)
# ──────────────────────────────────────────────────────────────────────────────
# Correo del encargado que recibe el aviso de nuevas consultas. Si no se define,
# se usa el email configurado en el footer del sitio (o contacto@techhub.cl).
#
#   CONTACT_NOTIFY_EMAIL=encargado@uls.cl
#
CONTACT_NOTIFY_EMAIL=

# Aviso agrupado (SEC-09): el encargado recibe como máximo un correo cada
# CONTACT_DIGEST_INTERVAL_MINUTES, y solo si llegó al menos una consulta desde
# el último aviso. Para que las últimas consultas no esperen a que llegue otra,
# programa bin/contact-digest.php con cron (ver README.hosting.md).
#
#   CONTACT_DIGEST_INTERVAL_MINUTES=60
#
CONTACT_DIGEST_INTERVAL_MINUTES=60

# ──────────────────────────────────────────────────────────────────────────────
# Tope de correos por ámbito (SEC-09)
# ──────────────────────────────────────────────────────────────────────────────
# Protege la cuota del proveedor de correo (p. ej. el plan de Resend) frente al
# envío automatizado de formularios. MAIL_DAILY_LIMIT es el máximo diario del
# plan; cada ámbito puede usar solo el porcentaje indicado, contado en las
# últimas 24 horas. Al llegar al tope, los correos de ese ámbito no se envían
# (los mensajes quedan guardados en la base de datos).
#
#   MAIL_DAILY_LIMIT=100              # máximo diario del plan
#   MAIL_SHARE_CONTACT=20             # % para los avisos de consultas de contacto
#   MAIL_SHARE_CREDITS=20             # % para los mensajes a integrantes (Créditos)
#   MAIL_SHARE_PASSWORD_RESET=15      # % para la recuperación de contraseña
#
MAIL_DAILY_LIMIT=100
MAIL_SHARE_CONTACT=20
MAIL_SHARE_CREDITS=20
MAIL_SHARE_PASSWORD_RESET=15

# ──────────────────────────────────────────────────────────────────────────────
# Derivación a plataforma de tickets (RF-CON-001)
# ──────────────────────────────────────────────────────────────────────────────
# URL de la plataforma de tickets a la que se redirige al usuario tras un envío
# exitoso del formulario de contacto. Si queda vacía, se redirige a una página
# en blanco a modo de placeholder.
#
#   TICKET_PLATFORM_URL=https://tickets.uls.cl
#
TICKET_PLATFORM_URL=
