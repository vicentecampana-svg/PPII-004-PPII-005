APP_ENV=development
APP_PORT=
APP_URL=

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# ──────────────────────────────────────────────────────────────────────────────
# SMTP — Recuperación de contraseña (issue #15)
# ──────────────────────────────────────────────────────────────────────────────
# Sin estas variables, los correos se loguean en storage/logs/mail_dev.log.
# Cuando el cliente confirme el servidor universitario, define:
#
#   MAIL_DRIVER=smtp              # activa el envío real (por defecto: log)
#   SMTP_HOST=smtp.uls.cl         # host del servidor universitario
#   SMTP_PORT=587                 # 587 = STARTTLS  |  465 = SSL
#   SMTP_USER=no-reply@uls.cl     # cuenta de envío
#   SMTP_PASS=                    # contraseña de la cuenta SMTP
#   SMTP_FROM=no-reply@uls.cl     # dirección From visible en el correo
#   SMTP_FROM_NAME=TechHub ULS    # nombre del remitente
#
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@techhub.uls.cl
SMTP_FROM_NAME=TechHub ULS
